__pycache__/
*.pyc
*.pyo
*.log
.DS_Store

# Генерируемые артефакты пайплайна (auto/ пишет сюда по умолчанию; CARROTAGE_OUT)
/output/

# Сторонний код-анализатор graphify (ROADMAP §7 — к проекту отношения не имеет)
graphify-out/

# Тяжёлые бинарные веса/кэши R&D — регенерируемы, см. digitizer/rnd/README.md
*.pt
*.npy
*.npz
# ★ ИСКЛЮЧЕНИЕ (§6.68): веса оконного селектора — ЕДИНСТВЕННЫЙ .pt под контролем версий.
# От него зависит ВЫДАЧА прода, поэтому он версионируется вместе с кодом, а не «регенерируется»:
# без совпадающих весов цифры §6.66 невоспроизводимы. 359 КБ — LFS не нужен.
!/auto/models/*.pt

# Референсный лист MK в корне: данные, не код (на него ссылаются digitizer/rnd/mk_*.py)
/Yatskivska_1_MK_*

# Бэкапы редакторов/скриптов (курируемые файлы живут в git, .bak избыточен)
*.bak
